<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PowerWEB 4.0 - Pentest Workbench" Width="1240" Height="850" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F1F5FA" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#DFE9F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CED8E5"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="14,9"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="Background" Value="White"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionMode" Value="Single"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="PowerWEB" FontSize="32" FontWeight="Bold" Foreground="#125CA5"/><TextBlock Text="Explore targets · Inspect requests · Evidence findings" Foreground="#526174"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NewProject" Content="New"/><Button x:Name="LoadProject" Content="Load project"/><Button x:Name="SaveProject" Content="Save"/><Button x:Name="Export" Content="Export report" Background="#125CA5" Foreground="White"/></StackPanel>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" BorderBrush="#CED8E5">
   <TabItem Header="1  Engagement and Scan"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="Engagement and target scope" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="Project name"/><TextBox x:Name="ProjectName" Text="New pentest" Margin="0,4,0,12"/>
    <TextBlock Text="Target scope (optional): scheme, host, port and optional path (e.g. https://example.org/app/). Leave empty to work without a scope; a crawl / native engine / role comparison still needs one."/><TextBox x:Name="Scope" Margin="0,4,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Additional start URLs, one per line (optional)"/><TextBox x:Name="Seeds" Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Exclusions: substrings, one per line"/><TextBox x:Name="Excludes" Text="logout&#10;signout&#10;delete&#10;remove&#10;unsubscribe" Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,0,0,12"><TextBlock Text="Max pages" VerticalAlignment="Center"/><TextBox x:Name="MaxPages" Text="20" Width="65" Margin="8,0,20,0"/><TextBlock Text="Link depth" VerticalAlignment="Center"/><TextBox x:Name="MaxDepth" Text="2" Width="55" Margin="8,0,20,0"/><TextBlock Text="Delay (ms)" VerticalAlignment="Center"/><TextBox x:Name="Delay" Text="250" Width="75" Margin="8,0,20,0"/><TextBlock Text="Timeout (s)" VerticalAlignment="Center"/><TextBox x:Name="Timeout" Text="15" Width="65" Margin="8,0,0,0"/></WrapPanel>
    <Expander Header="Auth headers for this run (memory only)" Margin="0,0,0,12"><StackPanel><TextBlock Text="For example Authorization: Bearer ... or Cookie: ... . Session A/B on tab 7; Set-Cookie is kept for native requests. No automatic login." Foreground="#526174" Margin="0,8"/><TextBox x:Name="AuthHeaders" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></StackPanel></Expander>
    <CheckBox x:Name="Active" Content="Additional active checks: CORS, OPTIONS and neutral parameter reflection" Margin="0,0,0,8"/>
    <TextBlock Text="The crawler fetches links and redirects inside the scope. Even GET requests can change poorly built applications. Define the test scope and exclusions beforehand." Foreground="#526174" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="Start" Content="Start scan" Background="#125CA5" Foreground="White"/><Button x:Name="Cancel" Content="Cancel run" IsEnabled="False"/></StackPanel>
    <TextBlock Text="Engagement, authorization, test accounts and other notes" Margin="0,18,0,4"/><TextBox x:Name="Notes" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="2  Findings"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button x:Name="NewFinding" Content="Add manual finding" DockPanel.Dock="Right"/><TextBox x:Name="Filter" ToolTip="Filter findings by title, URL, risk or status" MinWidth="200"/></DockPanel>
    <DataGrid x:Name="Findings" Grid.Row="1" IsReadOnly="True"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="28"/><Style.Triggers><DataTrigger Binding="{Binding Risiko}" Value="High"><Setter Property="Background" Value="#FFE5E5"/></DataTrigger><DataTrigger Binding="{Binding Risiko}" Value="Critical"><Setter Property="Background" Value="#FFD1D1"/></DataTrigger><DataTrigger Binding="{Binding Risiko}" Value="Medium"><Setter Property="Background" Value="#FFF2D7"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Fixed"><Setter Property="Background" Value="#E8F6EC"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Risk" Binding="{Binding Risiko}" Width="85"/><DataGridTextColumn Header="Finding" Binding="{Binding Titel}" Width="*" MinWidth="210"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Source" Binding="{Binding Quelle}" Width="95"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="FindingTitle" ToolTip="Title" Margin="0,0,0,8"/><TextBox x:Name="FindingUrl" Grid.Column="2" ToolTip="Affected URL" Margin="0,0,0,8"/>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Risk" VerticalAlignment="Center"/><ComboBox x:Name="Risk" Width="105" Margin="8,0,16,0"/><TextBlock Text="Status" VerticalAlignment="Center"/><ComboBox x:Name="FindingStatus" Width="150" Margin="8,0,0,0"/></StackPanel>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="Title / URL above; evidence and recommendation below. Confirm automatic hints on their merits." Foreground="#526174"/>
     <TextBox x:Name="Evidence" Grid.Row="2" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Evidence and reproduction steps"/>
     <TextBox x:Name="Remedy" Grid.Row="2" Grid.Column="2" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Recommendation"/>
     <Button x:Name="ApplyFinding" Grid.Row="3" Grid.Column="2" Content="Apply finding" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="3  Requests"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Method" Margin="0,0,8,0"/><TextBox x:Name="RequestUrl" Grid.Column="1"/><Button x:Name="Send" Grid.Column="2" Content="Send" Margin="8,0,0,0" Background="#125CA5" Foreground="White"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Additional headers (override auth headers of the same name)"/><TextBox x:Name="RequestHeaders" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Request body (UTF-8)"/><TextBox x:Name="RequestBody" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/></StackPanel></Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,10"><CheckBox x:Name="AllowWrite" Content="POST / PUT / PATCH / DELETE authorized for this manual request"/><WrapPanel Margin="0,10,0,0"><Button x:Name="Baseline" Content="Remember response for comparison"/><Button x:Name="Compare" Content="Compare with remembered response"/><Button x:Name="Diff" Content="Diff bodies"/><Button x:Name="RequestCopyCurl" Content="Copy as cURL"/><Button x:Name="RequestFromCurl" Content="From cURL"/><TextBlock Text="Responses stay in memory; header secrets are hidden." VerticalAlignment="Center" Foreground="#526174"/></WrapPanel></StackPanel>
    <TextBox x:Name="Response" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
   <TabItem Header="4  Parameters"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Compare your own test values" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="URL with exactly one {{PAYLOAD}} in the query, e.g. https://example.org/search?q={{PAYLOAD}}. Each value is URL-encoded. At most 50 GET requests; no automatic exploitability rating." Margin="0,8,0,10"/><TextBox x:Name="FuzzUrl"/></StackPanel>
    <TextBox x:Name="Payloads" Grid.Row="1" Height="95" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10" ToolTip="One test value per line"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="Fuzz" Content="Test parameter" Background="#125CA5" Foreground="White"/><Button x:Name="StopFuzz" Content="Cancel run" IsEnabled="False"/><TextBlock Text="Test values and URLs may be sensitive; review before exporting a report." VerticalAlignment="Center" Foreground="#526174"/></StackPanel>
    <DataGrid x:Name="FuzzResults" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="True"/>
   </Grid></TabItem>
   <TabItem Header="5  History"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="All logged requests. Select a row to inspect the URL in the request editor." Margin="0,0,0,12"/><DataGrid x:Name="History" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Method" Binding="{Binding Methode}" Width="80"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="280"/><DataGridTextColumn Header="HTTP" Binding="{Binding Status}" Width="65"/><DataGridTextColumn Header="ms" Binding="{Binding DauerMs}" Width="65"/><DataGridTextColumn Header="Test" Binding="{Binding Typ}" Width="140"/><DataGridTextColumn Header="Error" Binding="{Binding Fehler}" Width="200"/></DataGrid.Columns></DataGrid><Button x:Name="Replay" Grid.Row="2" Content="Open URL in request editor" HorizontalAlignment="Right" Margin="0,12,0,0"/></Grid></TabItem>
   <TabItem Header="6  Manual review"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="A complete pentest needs application-specific tests. Edit status and evidence directly in the table. Open does not mean reviewed. These entries appear in the report." Margin="0,0,0,12"/><DataGrid x:Name="Checklist" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Area" Binding="{Binding Bereich}" IsReadOnly="True" Width="185"/><DataGridComboBoxColumn x:Name="ChecklistStatus" Header="Status" SelectedItemBinding="{Binding Status}" Width="140"/><DataGridTextColumn Header="Task" Binding="{Binding Anleitung}" IsReadOnly="True" Width="*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Notes / evidence (editable)" Binding="{Binding Notizen}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="7  Native engine"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Native scan engine with evidence" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Runs on PowerShell and .NET only: no other scan tools required. Scope, start URLs, link depth, delay and timeout from tab 1 apply. GET requests are modified; define the test scope first." Margin="0,8,0,12"/>
     <WrapPanel><TextBlock Text="Pages" VerticalAlignment="Center"/><TextBox x:Name="NativePages" Text="10" Width="55" Margin="8,0,14,0"/><TextBlock Text="Request budget" VerticalAlignment="Center"/><TextBox x:Name="NativeRequests" Text="150" Width="65" Margin="8,0,14,0"/><TextBlock Text="Parameters / page" VerticalAlignment="Center"/><TextBox x:Name="NativeParameters" Text="3" Width="55" Margin="8,0,14,0"/><TextBlock Text="Minutes" VerticalAlignment="Center"/><TextBox x:Name="NativeMinutes" Text="10" Width="55" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,14,0,10"><WrapPanel><CheckBox x:Name="NativeSqlError" Content="SQL error" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeSqlBool" Content="SQL response diff" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeTemplate" Content="Template evaluation" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeHtml" Content="HTML reflection" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeRedirect" Content="Redirects" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeCrlf" Content="Header injection" IsChecked="True" Margin="0,0,18,8"/><CheckBox x:Name="NativeCors" Content="CORS" IsChecked="True" Margin="0,0,18,8"/></WrapPanel>
     <CheckBox x:Name="NativeAuthorize" Content="The selected active GET tests are authorized for this scope" Margin="0,4,0,10"/>
     <StackPanel Orientation="Horizontal"><Button x:Name="NativeStart" Content="Start native engine" Background="#125CA5" Foreground="White"/><Button x:Name="NativeCancel" Content="Cancel" IsEnabled="False"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,8,0,12"><TextBlock Text="Two separate sessions (memory only)" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,8"><TextBlock Text="Active session" VerticalAlignment="Center"/><ComboBox x:Name="SessionChoice" Width="65" Margin="8,0,14,0"/><Button x:Name="SessionClear" Content="Clear active session"/><Button x:Name="SessionInfo" Content="Show cookie count"/></WrapPanel><TextBlock Text="Auth headers on tab 1; login via POST on tab 3. Set-Cookie is kept for native requests and scans. For a role comparison fetch the same URL with A and B. Sessions are not saved to the project." Foreground="#526174"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RoleUrl" ToolTip="URL for role comparison"/><Button x:Name="RoleCompare" Grid.Column="1" Content="Compare A / B" Margin="8,0,0,0"/></Grid></StackPanel>
    <DataGrid x:Name="NativeResults" Grid.Row="3" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Rule" Binding="{Binding Regel}" Width="135"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="100"/><DataGridTextColumn Header="Result" Binding="{Binding Ergebnis}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="8  Intruder"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Intruder: modify requests deliberately" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Choose a request from Proxy or Repeater, then mark a value with &#167; on both sides. Add test values below, preview the request count, and start. Position order: URL, headers, body. Scope, exclusions and session A/B apply." TextWrapping="Wrap" Foreground="#526174" Margin="0,8,0,12"/>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="IntruderMethod" Margin="0,0,8,0"/><TextBox x:Name="IntruderUrl" Grid.Column="1" ToolTip="Target URL with position markers"/><Button x:Name="IntruderFromRequest" Grid.Column="2" Content="From tab 3" Margin="8,0,0,0"/>
    </Grid>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Additional headers (markers allowed; override auth headers)"/><TextBox x:Name="IntruderHeaders" Height="70" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Request body (UTF-8; markers allowed)"/><TextBox x:Name="IntruderBody" Height="70" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,0,0,10"><Button x:Name="IntruderMarkUrl" Content="Mark selected URL text"/><Button x:Name="IntruderMarkHeaders" Content="Mark selected header text"/><Button x:Name="IntruderMarkBody" Content="Mark selected body text"/><Button x:Name="IntruderClearMarks" Content="Clear marks"/></WrapPanel>
    <WrapPanel Margin="0,0,0,10"><TextBlock Text="Attack mode" VerticalAlignment="Center"/><ComboBox x:Name="IntruderMode" Width="150" Margin="8,0,20,0"/><TextBlock Text="Max requests" VerticalAlignment="Center"/><TextBox x:Name="IntruderMax" Text="200" Width="70" Margin="8,0,20,0"/><CheckBox x:Name="IntruderEncode" Content="URL-encode payloads in the URL" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
    <TextBlock Text="Modes: Sniper (one set, each position in turn) · Battering ram (one set, same value in all positions) · Pitchfork (one set per position, in lockstep) · Cluster bomb (one set per position, all combinations). Set 1 applies to Sniper/Battering ram; for Pitchfork/Cluster bomb set N maps to position N." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Payload set 1 (position 1)"/><TextBox x:Name="IntruderSet1" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,4,0,0" ToolTip="One value per line"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Set 2 (position 2)"/><TextBox x:Name="IntruderSet2" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="4"><TextBlock Text="Set 3 (position 3)"/><TextBox x:Name="IntruderSet3" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="6"><TextBlock Text="Set 4 (position 4)"/><TextBox x:Name="IntruderSet4" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,10,0,0"><TextBlock Text="Grep match (regex)" VerticalAlignment="Center"/><TextBox x:Name="IntruderGrepMatch" Width="220" Margin="8,0,20,0" ToolTip="yes/no column: does the response body match this regex"/><TextBlock Text="Grep extract (regex)" VerticalAlignment="Center"/><TextBox x:Name="IntruderGrepExtract" Width="220" Margin="8,0,0,0" ToolTip="Extract column: first capture group (or whole match)"/></WrapPanel>
    <CheckBox x:Name="IntruderAuthorize" Content="State-changing method (POST/PUT/PATCH/DELETE) authorized for this scope" Margin="0,12,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="IntruderPreview" Content="Preview requests"/><Button x:Name="IntruderStart" Content="Start tests" Background="#125CA5" Foreground="White"/><Button x:Name="IntruderCancel" Content="Cancel" IsEnabled="False"/><Button x:Name="IntruderToRequest" Content="Open selected in request editor"/></StackPanel>
    <TextBlock x:Name="IntruderPlan" Text="Mark a position and enter payloads to preview." Foreground="#526174" Margin="0,0,0,8"/>
    <DataGrid x:Name="IntruderResults" Height="245" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Nr}" Width="40"/><DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="75"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="120"/><DataGridTextColumn Header="HTTP" Binding="{Binding HTTP}" Width="60"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="70"/><DataGridTextColumn Header="ms" Binding="{Binding Ms}" Width="60"/><DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="65"/><DataGridTextColumn Header="Extract" Binding="{Binding Extract}" Width="100"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="130"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Selected response (first 500 characters; test values and responses may be sensitive)" Margin="0,8,0,0"/><TextBox x:Name="IntruderResponse" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="9  Proxy"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Intercepting proxy" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="1. Optionally set an authorized scope on tab 1. 2. Start proxy. 3. Open a separate browser through the proxy. 4. Select a request in history and send it to Repeater or Intruder. With a scope only in-scope traffic is forwarded; with no scope every request is forwarded. HTTPS with a path scope or exclusions needs decryption to inspect paths. Only test targets you are authorized to test." TextWrapping="Wrap" Foreground="#526174" Margin="0,8,0,10"/>
     <WrapPanel Margin="0,0,0,6"><TextBlock Text="Port" VerticalAlignment="Center"/><TextBox x:Name="ProxyPort" Text="8081" Width="80" Margin="8,0,20,0"/><Button x:Name="ProxyStart" Content="Start proxy" Background="#125CA5" Foreground="White"/><Button x:Name="ProxyOpenBrowser" Content="Open browser through proxy" IsEnabled="False"/><Button x:Name="ProxyStop" Content="Stop proxy" IsEnabled="False"/></WrapPanel>
     <WrapPanel Margin="0,0,0,6"><TextBlock Text="Browser (Chrome/Edge)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="BrowserPath" Width="420" Margin="0,0,8,0" ToolTip="Path to chrome.exe or msedge.exe. Auto-detected at start; used by 'Open browser through proxy'."/><Button x:Name="ChooseBrowser" Content="File ..."/></WrapPanel>
     <WrapPanel Margin="0,0,0,6"><Button x:Name="ProxyTrustCa" Content="Trust CA once (Windows user)" ToolTip="Trust the PowerWEB CA for this Windows account until you remove it. This affects other apps in this account too."/><Button x:Name="ProxyRemoveCaTrust" Content="Remove CA trust"/><Button x:Name="ProxyExportCa" Content="Export CA cert"/><TextBlock x:Name="ProxyCaStatus" Text="CA trust: not checked" VerticalAlignment="Center" Foreground="#526174" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,0,0,6"><CheckBox x:Name="ProxyIntercept" Content="Intercept requests" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox x:Name="ProxyInterceptResp" Content="Intercept responses" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox x:Name="ProxyMitm" Content="Decrypt HTTPS (MITM)" VerticalAlignment="Center" Margin="0,0,16,0"/></WrapPanel>
     <TextBlock x:Name="ProxyNotice" TextWrapping="Wrap" Foreground="#9A4900" Margin="0,0,0,8"/>
    </StackPanel>
    <TabControl x:Name="ProxySubTabs" Grid.Row="1">
     <TabItem Header="HTTP history"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="ProxyHistory" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Zeit}" Width="80"/><DataGridTextColumn Header="Method" Binding="{Binding Methode}" Width="80"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="260"/><DataGridTextColumn Header="HTTP" Binding="{Binding HTTP}" Width="60"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="80"/><DataGridTextColumn Header="Scope" Binding="{Binding ImScope}" Width="60"/><DataGridTextColumn Header="Modified" Binding="{Binding Veraendert}" Width="90"/></DataGrid.Columns></DataGrid>
      <StackPanel Grid.Row="1" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="ProxyToRepeater" Content="Send to Repeater"/><Button x:Name="ProxyToIntruder" Content="Send to Intruder"/><Button x:Name="ProxyCopyCurl" Content="Copy as cURL"/><TextBlock Text="History stays in memory." VerticalAlignment="Center" Foreground="#526174"/></StackPanel><TextBox x:Name="ProxyDetails" Height="100" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
     </Grid></TabItem>
     <TabItem Header="Intercept"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,8">
       <TextBlock Text="Turn 'Intercept requests' / 'Intercept responses' on above, then edit a held message and Forward or Drop it. The conditions below decide which requests are held — anything that does not match passes straight through even while interception is on, so you are not forced to forward every request." TextWrapping="Wrap" Margin="0,0,0,6"/>
       <Border BorderBrush="#CED8E5" BorderThickness="1" Padding="8" Margin="0,0,0,2" CornerRadius="4">
        <StackPanel>
         <TextBlock Text="Hold a request only when it matches all of these (leave everything empty/off to hold every request):" Foreground="#526174" Margin="0,0,0,6"/>
         <WrapPanel>
          <CheckBox x:Name="ProxyIntScope" Content="Only in-scope" VerticalAlignment="Center" Margin="0,0,20,6" ToolTip="Only hold requests that match the target scope on tab 1 (no effect when no scope is set)."/>
          <CheckBox x:Name="ProxyIntSkipStatic" Content="Skip static assets (js/css/images/fonts/media)" VerticalAlignment="Center" Margin="0,0,20,6"/>
         </WrapPanel>
         <WrapPanel>
          <TextBlock Text="Only methods" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="ProxyIntMethods" Width="150" Margin="0,0,20,6" ToolTip="Comma list, e.g. POST,PUT,PATCH,DELETE. Empty = all methods."/>
          <TextBlock Text="URL contains" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="ProxyIntUrlContains" Width="180" Margin="0,0,20,6" ToolTip="Only hold requests whose URL contains this text. Empty = any."/>
          <TextBlock Text="URL excludes" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="ProxyIntUrlExcludes" Width="180" Margin="0,0,0,6" ToolTip="Never hold requests whose URL contains one of these (comma or newline separated)."/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
      <TextBox x:Name="ProxyInterceptBox" Grid.Row="1" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="ProxyForward" Content="Forward" IsEnabled="False" Background="#125CA5" Foreground="White"/><Button x:Name="ProxyDrop" Content="Drop" IsEnabled="False"/><TextBlock x:Name="ProxyInterceptState" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#526174"/></StackPanel>
     </Grid></TabItem>
     <TabItem Header="Rules"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
      <TextBlock Text="Request rules — set/add/remove Name: value · replace /regex/repl/ · body /regex/repl/" TextWrapping="Wrap"/>
      <TextBox x:Name="ProxyRules" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12" Text="# e.g. set X-Forwarded-For: 127.0.0.1"/>
      <TextBlock Text="Response rules — same syntax; body /regex/repl/ rewrites the response body" TextWrapping="Wrap"/>
      <TextBox x:Name="ProxyResponseRules" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12" Text="# e.g. remove Content-Security-Policy&#10;# body /Admin/ADMIN/"/>
      <Button x:Name="ProxyApplyRules" Content="Apply rules / options" HorizontalAlignment="Left"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid></TabItem>
   <TabItem Header="10  Data table"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Table-driven requests" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Reference table columns as $name in the URL, headers or body. The table's first line is the header (column names); every following line is one test case that is sent as its own request. Everything runs under scope, exclusions, header rules and limits from tab 1 and the active session from tab 7." Foreground="#526174" Margin="0,8,0,12"/>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="DataMethod" Margin="0,0,8,0"/><TextBox x:Name="DataUrl" Grid.Column="1" ToolTip="Target URL, e.g. https://target/app/search?q=$term&amp;id=$id"/><Button x:Name="DataFromRequest" Grid.Column="2" Content="From tab 3" Margin="8,0,0,0"/>
    </Grid>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Additional headers ($name allowed; override auth headers)"/><TextBox x:Name="DataHeaders" Height="64" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Request body (UTF-8; $name allowed)"/><TextBox x:Name="DataBody" Height="64" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <TextBlock Text="Value table: first line = column names, then one row per test case. Separator is auto-detected (tab, semicolon or comma) so you can paste from a spreadsheet. Lines starting with # are ignored." Foreground="#526174"/>
    <TextBox x:Name="DataTable" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,4,0,10" Text="term,id&#10;admin,1&#10;test,2&#10;guest,3"/>
    <WrapPanel Margin="0,0,0,6"><TextBlock Text="Max requests" VerticalAlignment="Center"/><TextBox x:Name="DataMax" Text="500" Width="70" Margin="8,0,20,0"/><CheckBox x:Name="DataEncode" Content="URL-encode values in the URL" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox x:Name="DataAuthorize" Content="State-changing method authorized" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel Margin="0,0,0,10"><TextBlock Text="Grep match (regex)" VerticalAlignment="Center"/><TextBox x:Name="DataGrepMatch" Width="220" Margin="8,0,20,0" ToolTip="yes/no column: does the response body match this regex"/><TextBlock Text="Grep extract (regex)" VerticalAlignment="Center"/><TextBox x:Name="DataGrepExtract" Width="220" Margin="8,0,0,0" ToolTip="Extract column: first capture group (or whole match)"/></WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="DataStart" Content="Run table" Background="#125CA5" Foreground="White"/><Button x:Name="DataCancel" Content="Cancel" IsEnabled="False"/><TextBlock Text="Reflection is not proof of exploitability. Values and URLs may be sensitive." VerticalAlignment="Center" Foreground="#526174"/></StackPanel>
    <DataGrid x:Name="DataResults" Height="240" IsReadOnly="True" AutoGenerateColumns="True"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="11  Repeater"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Slots (each keeps its own request and last response)" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"><Button x:Name="RepeaterNew" Content="New"/><Button x:Name="RepeaterDelete" Content="Delete"/></StackPanel>
     <ListBox x:Name="RepeaterSlots"/>
    </DockPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RepeaterMethod" Margin="0,0,8,0"/><TextBox x:Name="RepeaterUrl" Grid.Column="1"/><Button x:Name="RepeaterSend" Grid.Column="2" Content="Send" Margin="8,0,0,0" Background="#125CA5" Foreground="White"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Headers"/><TextBox x:Name="RepeaterHeaders" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Body (UTF-8)"/><TextBox x:Name="RepeaterBody" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/></StackPanel></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="RepeaterAllow" Content="POST / PUT / PATCH / DELETE authorized for this slot" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="RepeaterToIntruder" Content="To Intruder"/><Button x:Name="RepeaterCopyCurl" Content="Copy as cURL"/><Button x:Name="RepeaterFromCurl" Content="From cURL"/></StackPanel>
     <TextBox x:Name="RepeaterResponse" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="12  Sitemap"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10"><Button x:Name="SitemapRefresh" Content="Refresh"/><Button x:Name="SitemapImportHar" Content="Import HAR ..."/><TextBlock Text="Discovered URLs (host to path) from crawler, native engine, manual requests, repeater and — while running — the proxy history. Select a leaf node and send it on." VerticalAlignment="Center" Foreground="#526174"/></WrapPanel>
    <TreeView x:Name="SitemapTree" Grid.Row="1" BorderBrush="#CED8E5" FontFamily="Consolas"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Selected node:" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="SitemapToRequest" Content="To Requests (tab 3)"/><Button x:Name="SitemapToRepeater" Content="To Repeater"/><Button x:Name="SitemapToIntruder" Content="To Intruder"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="13  TLS / SSL"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="TLS / SSL scan (native)" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Raw ClientHello enumeration over TCP: protocol versions SSLv2/SSLv3 through TLS 1.3, cipher suites with strength classification, certificate hygiene and TLS weaknesses. No OpenSSL or other external tools. Only scan hosts you are authorized to test." TextWrapping="Wrap" Foreground="#526174" Margin="0,8,0,12"/>
    <WrapPanel Margin="0,0,0,10">
     <TextBlock Text="Host" VerticalAlignment="Center"/><TextBox x:Name="TlsHost" Width="260" Margin="8,0,20,0" ToolTip="Host name, host:port or https URL. Empty uses the scope host from tab 1."/>
     <TextBlock Text="Port" VerticalAlignment="Center"/><TextBox x:Name="TlsPort" Text="443" Width="70" Margin="8,0,20,0"/>
     <CheckBox x:Name="TlsEnumerate" Content="Enumerate all cipher suites" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
     <TextBlock Text="Timeout (s)" VerticalAlignment="Center"/><TextBox x:Name="TlsTimeout" Text="15" Width="55" Margin="8,0,0,0"/>
    </WrapPanel>
    <CheckBox x:Name="TlsActiveAuthorize" Content="Active vulnerability probes authorized (Heartbleed, CCS injection, TLS_FALLBACK_SCSV) — these send crafted TLS records to the target" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="TlsStart" Content="Start TLS scan" Background="#125CA5" Foreground="White"/><Button x:Name="TlsCancel" Content="Cancel" IsEnabled="False"/><TextBlock Text="Findings are added to tab 2; full details go into the exported report." VerticalAlignment="Center" Foreground="#526174"/></StackPanel>
    <TextBlock x:Name="TlsSummary" Text="Enter a host and start the scan." Foreground="#526174" Margin="0,0,0,10"/>
    <TextBlock Text="Protocols" FontWeight="SemiBold" Margin="0,4,0,4"/>
    <DataGrid x:Name="TlsProtocols" Height="130" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Protocol" Binding="{Binding Protokoll}" Width="130"/><DataGridTextColumn Header="Supported" Binding="{Binding Unterstuetzt}" Width="100"/><DataGridTextColumn Header="Ciphers" Binding="{Binding Ciphers}" Width="90"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Cipher suites offered" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <DataGrid x:Name="TlsCiphers" Height="200" IsReadOnly="True"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Weak}" Value="True"><Setter Property="Background" Value="#FFE5E5"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="70"/><DataGridTextColumn Header="Suite" Binding="{Binding Name}" Width="*" MinWidth="250"/><DataGridTextColumn Header="Kx" Binding="{Binding Kx}" Width="70"/><DataGridTextColumn Header="Enc" Binding="{Binding Enc}" Width="90"/><DataGridTextColumn Header="Bits" Binding="{Binding Bits}" Width="50"/><DataGridTextColumn Header="PFS" Binding="{Binding PFS}" Width="50"/><DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="170"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Vulnerabilities and hardening checks" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <DataGrid x:Name="TlsVulns" Height="180" IsReadOnly="True"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Ergebnis}" Value="Vulnerable"><Setter Property="Background" Value="#FFD1D1"/></DataTrigger><DataTrigger Binding="{Binding Ergebnis}" Value="At risk"><Setter Property="Background" Value="#FFF2D7"/></DataTrigger><DataTrigger Binding="{Binding Ergebnis}" Value="Potentially vulnerable"><Setter Property="Background" Value="#FFF2D7"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Result" Binding="{Binding Ergebnis}" Width="150"/><DataGridTextColumn Header="Active" Binding="{Binding Aktiv}" Width="60"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Certificate" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <TextBox x:Name="TlsCert" Height="160" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready. Set an optional target scope, or start straight from Requests, Repeater, Intruder or the proxy." FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="PowerWEB 4.0 · NoAuthZone · MIT" Foreground="#526174" Margin="16,0,0,0"/></Grid>
 </Grid>
</Window>
